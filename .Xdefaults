*color8:  #928374
!! DarkRed + Red
*color1:  #cc241d
*color9:  #fb4934
!! DarkGreen + Green
*color2:  #98971a
*color10: #b8bb26
!! DarkYellow + Yellow
*color3:  #d79921
*color11: #fabd2f
!! DarkBlue + Blue
*color4:  #458588
*color12: #83a598
!! DarkMagenta + Magenta
*color5:  #b16286
*color13: #d3869b
!! DarkCyan + Cyan
